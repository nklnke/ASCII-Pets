{
  "name": "ascii-pets",
  "version": "1.0.0",
  "description": "ASCII-art desktop pets",
  "author": "ASCII Pets",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --format=iife --outfile=dist/renderer/renderer.js && node -e \"require('fs').mkdirSync('dist/renderer',{recursive:true});require('fs').copyFileSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "build": "npm run build:main && npm run check && npm run build:renderer",
    "test": "npm run build:main && node --test test/pet-stats.test.mjs test/placement.test.mjs test/skins.test.mjs test/temperament.test.mjs test/color.test.mjs test/notify.test.mjs",
    "dev": "node scripts/dev.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.ascii.pets",
    "productName": "ASCII Pets",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "assets/icon-16.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ASCII Pets"
    }
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
